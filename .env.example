# Deep Fusion 环境变量配置
# 将本文件复制为 .env 并根据实际环境修改
#
# 代理配置（东方财富接口需要代理）
# 7897 = Clash 混合代理端口（推荐），7890 = Clash HTTP 代理端口
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1,192.168.*.*,10.*,*.local,swsresearch.com

# 数据源配置
OKX_BASE_URL=https://www.okx.com
BINANCE_BASE_URL=https://api.binance.com
NEWSNOW_BASE_URL=https://newsnow.busiyi.world
NEWSNOW_CHANNELS=wallstreetcn-quick,cls-telegraph,jin10

# 服务配置
PORT=80
TRANSPORT=stdio
REQUEST_TIMEOUT=30

# 缓存目录（默认: Windows ~/AppData/Local/Cache/deep_fusion, Linux/Mac ~/.cache/deep_fusion）
# DEEP_FUSION_CACHE_DIR=C:\Users\username\.cache\deep_fusion
