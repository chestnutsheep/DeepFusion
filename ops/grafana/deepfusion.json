{
  "title": "DeepFusion 性能监控",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "title": "缓存命中率",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "expr": "sum(rate(deepfusion_cache_hits_total[5m])) / (sum(rate(deepfusion_cache_hits_total[5m])) + sum(rate(deepfusion_cache_misses_total[5m]))) * 100",
        "legendFormat": "命中率"
      }],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [
        {"color": "red", "value": 0},
        {"color": "yellow", "value": 50},
        {"color": "green", "value": 80}
      ]}}}
    },
    {
      "title": "akshare 调用 p95 耗时（按 tool）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(deepfusion_request_latency_seconds_bucket[5m])) by (le, tool))",
        "legendFormat": "{{tool}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "Executor 饱和度",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{
        "expr": "deepfusion_executor_active",
        "legendFormat": "活跃任务数"
      }],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "事件循环阻塞 p95（按 op）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(deepfusion_event_loop_block_seconds_bucket[5m])) by (le, op))",
        "legendFormat": "{{op}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "DCC-GARCH 拟合耗时（按阶段）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(deepfusion_dcc_fit_latency_seconds_bucket[5m])) by (le, stage))",
        "legendFormat": "{{stage}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "akshare 超时次数",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{
        "expr": "rate(deepfusion_akshare_timeout_total[5m])",
        "legendFormat": "{{fun}}"
      }],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "title": "缓存命中/未命中（按层）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "rate(deepfusion_cache_hits_total[5m])", "legendFormat": "命中 {{layer}}"},
        {"expr": "rate(deepfusion_cache_misses_total[5m])", "legendFormat": "未命中"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ]
}
